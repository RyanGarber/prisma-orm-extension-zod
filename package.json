{
	"name": "@ryangarber/prisma-orm-extension-zod",
	"version": "0.2.7",
	"description": "Support for Zod types and validation in Prisma 8.",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"prisma",
		"postgres",
		"zod"
	],
	"author": "Ryan Garber <ryanmichaelgarber@gmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/ryangarber/prisma-orm-extension-zod.git"
	},
	"exports": {
		"./codec-types": "./dist/codec-types.mjs",
		"./codecs": "./dist/codecs.mjs",
		"./column-types": "./dist/column-types.mjs",
		"./control": "./dist/control.mjs",
		"./pack": "./dist/pack.mjs",
		"./runtime": "./dist/runtime.mjs",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"lint": "biome check --write",
		"test": "vitest run",
		"prepublishOnly": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
		"typecheck": "tsc --noEmit",
		"release": "bumpp --commit --push --tag && pnpm publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@prisma/orm-postgres": "8.0.0-rc.17",
		"@prisma/orm-toolchain": "8.0.0-rc.17",
		"@types/node": "^26.6.4",
		"bumpp": "^12.3.0",
		"temporal-zod": "0.8.0",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.3"
	},
	"packageManager": "pnpm@12.10.1+sha512.ba40a37eb1a370d60fea8c4cf1d364c13bcccef518e98ad2bcee954f539d38da37458e58261a3fa55e06523450ea0ffff9f497b135be41f2c15c1642bacace6c",
	"dependencies": {
		"ponyfill-temporal": "0.1.0",
		"zod": "^4.6.5"
	},
	"peerDependencies": {
		"@prisma/orm-postgres": "8.0.0-rc.17"
	}
}
