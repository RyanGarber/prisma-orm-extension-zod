{
	"name": "@ryangarber/prisma-orm-extension-zod",
	"version": "0.2.0",
	"description": "Support for Zod types and validation in Prisma 8.",
	"type": "module",
	"sideEffects": false,
	"license": "MIT",
	"publishConfig": {
		"access": "public"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"prisma",
		"postgres",
		"zod"
	],
	"author": "Ryan Garber <ryanmichaelgarber@gmail.com>",
	"repository": {
		"type": "git",
		"url": "https://github.com/ryangarber/prisma-orm-extension-zod.git"
	},
	"exports": {
		"./codec-types": "./dist/codec-types.mjs",
		"./codecs": "./dist/codecs.mjs",
		"./column-types": "./dist/column-types.mjs",
		"./control": "./dist/control.mjs",
		"./pack": "./dist/pack.mjs",
		"./runtime": "./dist/runtime.mjs",
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsdown",
		"lint": "biome check --write",
		"test": "vitest run",
		"prepublishOnly": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
		"typecheck": "tsc --noEmit",
		"release": "bumpp --commit --push --tag && pnpm publish"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.12",
		"@prisma/orm-postgres": "8.0.0-rc.8",
		"@prisma/orm-toolchain": "8.0.0-rc.8",
		"@types/node": "^22.20.2",
		"bumpp": "^12.3.0",
		"temporal-zod": "0.7.0",
		"tsdown": "^0.23.0",
		"typescript": "^7.0.2",
		"vitest": "^5.0.0"
	},
	"packageManager": "pnpm@12.3.4",
	"dependencies": {
		"ponyfill-temporal": "0.1.0",
		"zod": "^4.6.1"
	},
	"peerDependencies": {
		"@prisma/orm-postgres": "8.0.0-rc.8"
	}
}
